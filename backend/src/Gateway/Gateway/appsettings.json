{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5050",
  "Cors": {
    "Origins": [ "http://localhost:3000", "http://localhost:3001", "http://localhost:3002", "http://localhost:8081" ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      },
      "orders": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": { "d1": { "Address": "http://localhost:5101/" } },
        "HealthCheck": { "Active": { "Enabled": true, "Path": "/health", "Interval": "00:00:15" } }
      },
      "inventory": {
        "Destinations": { "d1": { "Address": "http://localhost:5102/" } },
        "HealthCheck": { "Active": { "Enabled": true, "Path": "/health", "Interval": "00:00:15" } }
      },
      "orders": {
        "Destinations": { "d1": { "Address": "http://localhost:5103/" } },
        "HealthCheck": { "Active": { "Enabled": true, "Path": "/health", "Interval": "00:00:15" } }
      }
    }
  }
}
